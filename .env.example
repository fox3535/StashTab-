# Copy to .env.local (Next.js) and services/api/.env (Python API)

# --- Next.js / Clerk / Convex (from starter) ---
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_FRONTEND_API_URL=
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/pos
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/pos
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/pos
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/pos

# --- Mimir Python API ---
NEXT_PUBLIC_MIMIR_API_URL=http://localhost:8000
DATABASE_URL=postgresql://mimir:mimir@localhost:5432/mimir
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Dev only: default shop until Clerk org mapping is wired
NEXT_PUBLIC_DEV_SHOP_ID=
