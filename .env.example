# Copy to .env.local (Next.js) and services/api/.env (Python API)

# API environment: local | test | staging | production
# Missing or invalid values never enable the local identity bypass.
APP_ENV=local

# Named local/test identity bypass only. Ignored for staging/production.
# DEBUG=true is not enough.
STASHTAB_ALLOW_DEV_IDENTITY=1

# --- Next.js / Clerk ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_FRONTEND_API_URL=
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/pos
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/pos
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/pos
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/pos

# Billing defaults off. The landing PricingTable renders only when this is
# explicitly "true"; otherwise an honest "Plans coming soon" fallback shows.
NEXT_PUBLIC_BILLING_ENABLED=false

# --- Mimir Python API ---
NEXT_PUBLIC_MIMIR_API_URL=http://localhost:8000
DATABASE_URL=postgresql://mimir:mimir@localhost:5432/mimir
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Dev only: default shop until Clerk org mapping is wired
NEXT_PUBLIC_DEV_SHOP_ID=

# Web Push private keys belong only in services/api/.env. The public key is
# fetched from the API when delivery is enabled.
