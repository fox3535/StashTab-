DATABASE_URL=postgresql://mimir:mimir@localhost:5432/mimir
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000
DEBUG=true
APP_ENV=local
STASHTAB_ALLOW_DEV_IDENTITY=1

# Clerk JWT required in staging/production. Issuer must match the token `iss`.
# Authorized parties are the allowed Clerk `azp` origins (comma-separated).
# CLERK_JWT_ISSUER=https://your-instance.clerk.accounts.dev
# CLERK_AUTHORIZED_PARTIES=http://localhost:3000,https://app.example.com
# Optional `aud` check if Clerk is configured to emit audience:
# CLERK_JWT_AUDIENCE=

# Web Push remains disabled until public key, private key, and a real subject
# are set. Leave VAPID_SUBJECT empty; mailto:ops@example.com does not enable push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Optional extra HTTPS Web Push host suffixes, comma-separated.
WEB_PUSH_ALLOWED_HOST_SUFFIXES=
